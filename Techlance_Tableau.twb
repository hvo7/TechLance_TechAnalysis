    <worksheet name='Seasonality Heatmap'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Tableau Bold' fontsize='18'>October Consistenly Shows the Weakest Monthly Sales Momentum</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='orders_data_cleaned (Elist_Analysis)' name='federated.1qaeol20j4rj4017v9vj40x3lr4e' />
          </datasources>
          <datasource-dependencies datasource='federated.1qaeol20j4rj4017v9vj40x3lr4e'>
            <column caption='Sales MoM' datatype='real' name='[Calculation_0546798776938498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([USD_PRICE])/LOOKUP(SUM([USD_PRICE]), -1) ) -1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
