      <aliases enabled='yes' />
      <column caption='Account Creation Method' datatype='string' name='[ACCOUNT_CREATION_METHOD]' role='dimension' type='nominal' />
      <column caption='Country Code' datatype='string' name='[COUNTRY_CODE]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Currency' datatype='string' name='[CURRENCY]' role='dimension' type='nominal' />
      <column caption='Sales MoM' datatype='real' name='[Calculation_0546798776938498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([USD_PRICE])/LOOKUP(SUM([USD_PRICE]), -1) ) -1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_1396171184496640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([USD_PRICE]) / COUNT([ORDER_ID])' />
      </column>
      <column caption='Delivery Ts' datatype='date' name='[DELIVERY_TS]' role='dimension' type='ordinal' />
      <column caption='Local Price' datatype='real' name='[LOCAL_PRICE]' role='measure' type='quantitative' />
      <column caption='Loyalty Program' datatype='integer' name='[LOYALTY_PROGRAM]' role='measure' type='quantitative' />
      <column caption='Marketing Channel' datatype='string' name='[MARKETING_CHANNEL]' role='dimension' type='nominal' />
      <column caption='Order Id' datatype='string' name='[ORDER_ID]' role='dimension' type='nominal' />
      <column caption='Product Id' datatype='string' name='[PRODUCT_ID]' role='dimension' type='nominal' />
      <column caption='Product Name' datatype='string' name='[PRODUCT_NAME]' role='dimension' type='nominal' />
      <column caption='Product Name Cleaned' datatype='string' name='[PRODUCT_NAME_CLEANED]' role='dimension' type='nominal' />
      <column caption='Purchase Month' datatype='date' name='[PURCHASE_MONTH]' role='dimension' type='ordinal' />
      <column caption='Purchase Platform' datatype='string' name='[PURCHASE_PLATFORM]' role='dimension' type='nominal' />
      <column caption='Purchase Ts' datatype='date' name='[PURCHASE_TS]' role='dimension' type='ordinal' />
      <column caption='Purchase Ts Cleaned' datatype='date' name='[PURCHASE_TS_CLEANED]' role='dimension' type='ordinal' />
      <column caption='Purchase Year' datatype='integer' name='[PURCHASE_YEAR]' role='dimension' type='quantitative' />
      <column caption='Product Brands' datatype='string' name='[Product Name Cleaned (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[PRODUCT_NAME_CLEANED]' default='&quot;Other&quot;' new-bin='true'>
          <bin default-name='false' value='&quot;Apple&quot;'>
            <value>&quot;Apple Airpods Headphones&quot;</value>
